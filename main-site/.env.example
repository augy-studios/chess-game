# uwuChess, the Vercel project (root directory main-site).
# Set these in Vercel, Project Settings, Environment Variables. For local
# `vercel dev`, copy to .env; .env is gitignored and never deployed.
# This file never holds a real value.

# The shared uwuapps Supabase project.
# Supabase dashboard, Project Settings, Data API: the Project URL.
SUPABASE_URL=

# The service_role key, from the same page. Bypasses row level security:
# used only by the functions in api/, never sent to a browser.
SUPABASE_SERVICE_KEY=
